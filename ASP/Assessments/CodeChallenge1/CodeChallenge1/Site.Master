<%@ Master Language="C#" AutoEventWireup="true"
CodeBehind="Site.Master.cs"
Inherits="CodeChallenge1.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Food Order Management</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f4f6f9;
        }

        .header {
            background: #2a5298;
            color: white;
            padding: 15px;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
        }

        .menu {
            background: #1e3c72;
            padding: 12px;
            text-align: center;
        }

        .menu a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            padding: 8px 12px;
            border-radius: 5px;
            transition: 0.3s;
            display: inline-block;
        }

        .menu a:hover {
            background: #2a5298;
        }

        .content {
            width: 90%;
            margin: 20px auto;
            min-height: 400px;
        }
        .footer {
            background: #2a5298;
            color: white;
            text-align: center;
            padding: 10px;
            position: relative;
            bottom: 0;
            width: 100%;
            margin-top: 30px;
        }

        .page-box {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 5px 15px rgba(0,0,0,0.2);
        }
    </style>
</head>

<body>

<form runat="server">

    <div class="header">
         Food Order Management System
    </div>

    <div class="menu">

        <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl="~/MenuList.aspx">
            Menu Items
        </asp:HyperLink>

        <asp:HyperLink ID="HyperLink2" runat="server" NavigateUrl="~/AddEditMenu.aspx">
            Add Menu
        </asp:HyperLink>

        <asp:HyperLink ID="HyperLink3" runat="server" NavigateUrl="~/OrderStats.aspx">
            Order Stats
        </asp:HyperLink>

        <asp:HyperLink ID="HyperLink4" runat="server" NavigateUrl="~/Logout.aspx">
            Logout
        </asp:HyperLink>

    </div>

    <div class="content">
        <div class="page-box">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>
    </div>

    <div class="footer">
        © 2026 Food Order Management System | All Rights Reserved
    </div>

</form>

</body>
</html>